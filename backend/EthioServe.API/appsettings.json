{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Jwt": {
    "Issuer": "EthioServe",
    "Audience": "EthioServe.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "RateLimiting": {
    "GlobalPermitsPerMinute": 100,
    "AuthPermitsPerMinute": 10
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Security": {
    "TokenCleanupIntervalMinutes": 360
  },
  "Email": {
    "Provider": "None",
    "Region": "eu-west-2",
    "SenderAddress": ""
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:4200",
    "PasswordResetTokenMinutes": 60,
    "LogEmailBodies": false
  }
}
